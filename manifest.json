{
    "manifest_version": 2,
    "name": "tratra",
    "version": "2.0.0",
    "description": "Firefox, mimi utils",
    "permissions": [
        "https://translate.googleapis.com/*",
        "storage"
    ],
    "background": {
        "scripts": [
            "background.js"
        ],
        "persistent": false
    },
    "options_ui": {
        "page": "options.html",
        "open_in_tab": true
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_idle",
            "all_frames": true,
            "match_about_blank": true
        }
    ],
    "browser_specific_settings": {
        "gecko": {
            "id": "enjaen-translator@example.com",
            "strict_min_version": "78.0"
        }
    }
}
